# Medical Data Validator — Environment Configuration
# Copy this file to .env and fill in the required values.
# Lines marked REQUIRED must be set before running in production.

# ── Flask / API ───────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=false
# REQUIRED in production — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED in production — separate secret for JWT signing
JWT_SECRET=change-me-in-production
# JWT lifetime in seconds (default 3600 = 1 hour)
JWT_EXPIRY_SECONDS=3600
# Password for the built-in admin user (change before first run)
ADMIN_PASSWORD=change-me-in-production
# API key for the default tenant (leave blank to disable API-key auth)
DEFAULT_TENANT_API_KEY=

# ── Persistence (SQLite paths; override with PostgreSQL DSN for production) ───
AUDIT_DB_DIR=~/.medical_validator
JOBS_DB_DIR=~/.medical_validator
REGISTRY_DB_PATH=~/.medical_validator/registry.db

# ── Redis / Celery (async jobs) ───────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── File upload ───────────────────────────────────────────────────────────────
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=csv,xlsx,xls,json,parquet

# ── Gunicorn (production) ─────────────────────────────────────────────────────
PORT=8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
